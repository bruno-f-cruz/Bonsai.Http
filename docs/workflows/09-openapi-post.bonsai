<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:http="clr-namespace:Bonsai.Http;assembly=Bonsai.Http" xmlns:api="clr-namespace:JsonPlaceholderApi;assembly=JsonPlaceholderApi" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns="https://bonsai-rx.org/2018/workflow" Version="2.9.0">
  <Description>Retrieve a JSONPlaceholder post using generated OpenAPI operators. Run run-openapi.ps1 first. Inspect Client for the typed result and use GetHttpResponse for transport diagnostics.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="api:CreateGetPostRequest">
          <api:Value>
            <api:PostId>1</api:PostId>
          </api:Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="api:Client">
          <api:BaseAddress>https://jsonplaceholder.typicode.com/</api:BaseAddress>
          <api:Timeout>PT20S</api:Timeout>
        </Combinator>
      </Expression>
      <Expression xsi:type="WorkflowOutput"/>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1"/>
      <Edge From="1" To="2" Label="Source1"/>
    </Edges>
  </Workflow>
</WorkflowBuilder>
