<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:http="clr-namespace:Bonsai.Http;assembly=Bonsai.Http" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns="https://bonsai-rx.org/2018/workflow" Version="2.9.0">
  <Description>GET the USGS past-hour earthquake feed every minute. Inspect the GeoJSON body in HttpClient for event magnitudes, locations, timestamps, and coordinates. The feed can contain zero events.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT1S</rx:DueTime>
          <rx:Period>PT1M</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="http:CreateHttpRequest">
          <http:Method>GET</http:Method>
          <http:Uri>earthquakes/feed/v1.0/summary/all_hour.geojson</http:Uri>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="http:HttpClient">
          <http:BaseAddress>https://earthquake.usgs.gov/</http:BaseAddress>
          <http:Timeout>PT20S</http:Timeout>
          <http:ConnectionLifetime>PT5M</http:ConnectionLifetime>
          <http:DefaultHeaders>
            <http:Header Name="Accept" Value="application/json"/>
          </http:DefaultHeaders>
        </Combinator>
      </Expression>
      <Expression xsi:type="WorkflowOutput"/>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1"/>
      <Edge From="1" To="2" Label="Source1"/>
      <Edge From="2" To="3" Label="Source1"/>
    </Edges>
  </Workflow>
</WorkflowBuilder>
