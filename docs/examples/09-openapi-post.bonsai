<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:http="clr-namespace:Bonsai.Http;assembly=Bonsai.Http" xmlns:api="clr-namespace:JsonPlaceholderApi;assembly=JsonPlaceholderApi" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Retrieve a JSONPlaceholder post using generated OpenAPI operators. Run run-openapi.ps1 first. Inspect GetPost for the typed result and use GetHttpResponse for transport diagnostics.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator"><Combinator xsi:type="http:CreateHttpClient"><http:BaseAddress>https://jsonplaceholder.typicode.com/</http:BaseAddress><http:Timeout>PT20S</http:Timeout></Combinator></Expression>
      <Expression xsi:type="rx:ResourceSubject"><Name>Api</Name></Expression>
      <Expression xsi:type="SubscribeSubject"><Name>Api</Name></Expression>
      <Expression xsi:type="Combinator"><Combinator xsi:type="api:CreateGetPostRequest"><api:Value><api:PostId>1</api:PostId></api:Value></Combinator></Expression>
      <Expression xsi:type="Combinator"><Combinator xsi:type="api:GetPost" /></Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="4" Label="Source2" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
