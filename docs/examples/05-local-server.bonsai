<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:server="clr-namespace:Bonsai.Http.Server;assembly=Bonsai.Http.Server" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Serve GET http://127.0.0.1:8080/hello from a Bonsai workflow. Inspect the incoming route node and change the configured response.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator"><Combinator xsi:type="server:CreateHttpServer"><server:Url>http://127.0.0.1:8080/</server:Url><server:RequestDeadline>PT10S</server:RequestDeadline></Combinator></Expression>
      <Expression xsi:type="rx:ResourceSubject"><Name>Server</Name></Expression>
      <Expression xsi:type="SubscribeSubject"><Name>Server</Name></Expression>
      <Expression xsi:type="Combinator"><Combinator xsi:type="server:ReceiveRequest"><server:Method>GET</server:Method><server:Pattern>/hello</server:Pattern></Combinator></Expression>
      <Expression xsi:type="Combinator"><Combinator xsi:type="server:CreateHttpServerResponse"><server:StatusCode>200</server:StatusCode><server:ContentType>application/json</server:ContentType><server:Body>{"message":"Hello from Bonsai"}</server:Body></Combinator></Expression>
      <Expression xsi:type="Combinator"><Combinator xsi:type="server:SendResponse" /></Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges><Edge From="0" To="1" Label="Source1" /><Edge From="2" To="3" Label="Source1" /><Edge From="3" To="4" Label="Source1" /><Edge From="4" To="5" Label="Source1" /><Edge From="5" To="6" Label="Source1" /></Edges>
  </Workflow>
</WorkflowBuilder>
