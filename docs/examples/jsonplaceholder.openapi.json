{
  "openapi": "3.0.3",
  "info": { "title": "JSONPlaceholder posts", "version": "1.0.0" },
  "paths": {
    "/posts/{postId}": {
      "get": {
        "operationId": "GetPost",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "description": "The identifier of the post to retrieve, from 1 to 100.", "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": { "description": "The requested post.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } } },
          "404": { "description": "The post does not exist." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "required": ["id", "userId", "title", "body"],
        "properties": {
          "id": { "type": "integer", "format": "int32", "description": "The post identifier." },
          "userId": { "type": "integer", "format": "int32", "description": "The author identifier." },
          "title": { "type": "string", "description": "The post title." },
          "body": { "type": "string", "description": "The post text." }
        }
      }
    }
  }
}
